{% if clustername == "local-cluster" %}
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: apache-vm-fedora
  namespace: cross-cluster-demo
spec:
  dataVolumeTemplates:
    - apiVersion: cdi.kubevirt.io/v1beta1
      kind: DataVolume
      metadata:
        creationTimestamp: null
        name: apache-vm-fedora
      spec:
        sourceRef:
          kind: DataSource
          name: fedora
          namespace: openshift-virtualization-os-images
        storage:
          resources:
            requests:
              storage: 30Gi
  runStrategy: RerunOnFailure
  template:
    metadata:
      labels:
        kubevirt.io/domain: apache-vm-fedora
        app: apache-dynamic
    spec:
      domain:
        cpu:
          cores: 2
        devices:
          disks:
            - name: rootdisk
              disk:
                bus: virtio
            - name: cloudinitdisk
              disk:
                bus: virtio
        resources:
          requests:
            memory: 2Gi
      volumes:
        - name: rootdisk
          dataVolume:
            name: apache-vm-fedora
        - name: cloudinitdisk
          cloudInitNoCloud:
            userData: |
              #cloud-config
              system_info:
                default_user:
                  name: fedora
                  plain_text_passwd: fedora
                  lock_passwd: false
                  sudo: ALL=(ALL) NOPASSWD:ALL
              package_update: false
              package_upgrade: false
              packages:
                # - httpd
                - nano
              write_files:
                - path: /opt/script.sh
                  content: |
                    #!/bin/bash
                    set -e
                    MIVAR_VALOR=$(curl -k https://kubernetes.default.svc.cluster.local:443/console | sed -n 's/.*apps\.\([^.]*\)\..*/\1/p')
                    echo "MIVAR obtenido desde Kubernetes: $MIVAR_VALOR"
                    if [ "$MIVAR_VALOR" == "" ]; then
                      resolvectl flush-cache
                      systemctl restart NetworkManager.service
                    fi
                    echo "$MIVAR_VALOR" > /var/run/watched.txt
                - path: /etc/systemd/system/my-script.service
                  content: |
                    [Unit]
                    Description=Servicio para mi proceso cada segundo
                    Wants=network-online.target
                    After=network-online.target
                    [Service]
                    Type=simple
                    EnvironmentFile=/etc/environment
                    ExecStart=/bin/bash /opt/script.sh
                - path: /etc/systemd/system/my-script.timer
                  content: |
                    [Unit]
                    Description=Ejecutar mi proceso cada segundo
                    [Timer]
                    OnBootSec=30s
                    OnUnitActiveSec=1s
                    AccuracySec=10ms
                    [Install]
                    WantedBy=timers.target
                - path: /etc/containers/systemd/live-migration-demo-app.container
                  content: |
                    [Unit]
                    Description=Live migration demo app container
                    StartLimitIntervalSec=0
                    [Container]
                    Image=quay.io/mvalledi/live-migration-demo-app:latest
                    ContainerName=live_migration_demo_app
                    PublishPort=8080:3000
                    Volume=/var/run/watched.txt:/app/watched.txt
                    Environment=HOSTNAME=%H
                    [Service]
                    Restart=always
                    RestartSec=5s
                    TimeoutStartSec=10
                    [Install]
                    WantedBy=multi-user.target default.target
              runcmd:
                - setenforce 0
                - sed -i 's/^SELINUX=.*/SELINUX=disabled/' /etc/selinux/config
                - systemctl daemon-reload
                - touch /var/run/watched.txt
                - systemctl enable --now my-script.timer
                - systemctl start live-migration-demo-app
                - systemctl enable --now live-migration-demo-app
{% endif %}
---

apiVersion: v1
kind: Service
metadata:
  name: apache-dynamic-service
  namespace: cross-cluster-demo
spec:
  selector:
    app: apache-dynamic
  ports:
    - port: 8080
      targetPort: 8080
  type: ClusterIP
---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: apache-dynamic-route
  namespace: cross-cluster-demo
spec:
  host: ohmygod.trafficmanager.net
  to:
    kind: Service
    name: apache-dynamic-service
    weight: 100
  port:
    targetPort: 8080
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Allow
  wildcardPolicy: None
---
kind: Route
apiVersion: route.openshift.io/v1
metadata:
  name: router-test
  namespace: cross-cluster-demo
spec:
  to:
    kind: Service
    name: apache-dynamic-service
    weight: 100
  port:
    targetPort: 8080
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Allow
  wildcardPolicy: None
