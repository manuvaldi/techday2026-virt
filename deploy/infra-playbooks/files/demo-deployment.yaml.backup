---
apiVersion: v1
kind: Namespace
metadata:
  labels:
    kubernetes.io/metadata.name: cross-cluster-demo
    name: cross-cluster-demo
  name: cross-cluster-demo
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: cluster-admin-default-sa
  namespace: cross-cluster-demo
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: admin
subjects:
- kind: ServiceAccount
  name: default
  namespace: cross-cluster-demo
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: my-config
  namespace: cross-cluster-demo
data:
  MIVAR: "Hola desde el ConfigMap 🚀 en {{clustername}}"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: apache-message
  namespace: cross-cluster-demo
data:
  script.sh: |
    #!/bin/bash

    set -e

    # ===== CONFIG =====
    NAMESPACE="cross-cluster-demo"
    CONFIGMAP_NAME="my-config"
    VAR_NAME="MIVAR"

    # ===== OBTENER VARIABLE DESDE CONFIGMAP =====
    MIVAR_VALOR=$(kubectl get configmap "$CONFIGMAP_NAME" \
      -n "$NAMESPACE" \
      -o jsonpath="{.data.$VAR_NAME}")

    if [ -z "$MIVAR_VALOR" ]; then
      echo "ERROR: No se pudo obtener $VAR_NAME del ConfigMap"
      exit 1
    fi

    echo "MIVAR obtenido desde Kubernetes: $MIVAR_VALOR"

    # ===== CONFIGURAR APACHE + SSI =====
    cat > /etc/httpd/conf.d/ssi.conf <<EOF
    LoadModule include_module modules/mod_include.so

    # Variable definida INTERNAMENTE en Apache (SSI la ve)
    SetEnv MIVAR "${MIVAR_VALOR}"

    <Directory "/var/www/html">
        Options +Includes
        AddOutputFilter INCLUDES .html
        Require all granted
    </Directory>
    EOF

    # ===== CREAR INDEX.HTML =====
    cat > /var/www/html/index.html <<'EOF'
    <!DOCTYPE html>
    <html>
    <head>
      <title>My Demo App</title>
    </head>
    <body>
      <h1>Apache leyendo ConfigMap de Kubernetes 🚀</h1>
      <p>Valor de MIVAR:</p>
      <h2><!--#echo var="MIVAR" --></h2>
    </body>
    </html>
    EOF

    # ===== ARRANCAR APACHE =====
    systemctl enable httpd
    systemctl restart httpd
---
{% if clustername == "local-cluster" %}
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: apache-vm-centos
  namespace: cross-cluster-demo
spec:
  runStrategy: Always
  template:
    metadata:
      labels:
        kubevirt.io/domain: apache-vm-centos
        app: apache-dynamic
    spec:
      domain:
        cpu:
          cores: 2
        devices:
          disks:
            - name: containerdisk
              disk:
                bus: virtio
            - name: cloudinitdisk
              disk:
                bus: virtio
            - name: html-message
              disk:
                bus: virtio
              serial: O9L74B
            - disk:
                bus: virtio
              name: default-sa
              serial: 7E60P0
        resources:
          requests:
            memory: 2Gi
      volumes:
        - name: containerdisk
          containerDisk:
            image: quay.io/containerdisks/centos-stream:9
        - name: html-message
          configMap:
            name: apache-message
        - name: default-sa
          serviceAccount:
            serviceAccountName: default
        - name: cloudinitdisk
          cloudInitNoCloud:
            userData: |
              #cloud-config
              system_info:
                default_user:
                  name: centos
                  plain_text_passwd: centos
                  lock_passwd: false
                  sudo: ALL=(ALL) NOPASSWD:ALL
              package_update: true
              package_upgrade: true
              packages:
                - httpd
                - nano
              write_files:
                - path: /etc/yum.repos.d/kubernetes.repo
                  permissions: '0644'
                  content: |
                    [kubernetes]
                    name=Kubernetes
                    baseurl=https://pkgs.k8s.io/core:/stable:/v1.29/rpm/
                    enabled=1
                    gpgcheck=1
                    gpgkey=https://pkgs.k8s.io/core:/stable:/v1.29/rpm/repodata/repomd.xml.key
                - path: /etc/environment
                  content: |
                    KUBERNETES_SERVICE_HOST="kubernetes.default.svc"
                    KUBERNETES_SERVICE_PORT=443
                  append: true
                - path: /etc/systemd/system/my-script.service
                  content: |
                    [Unit]
                    Description=Servicio para mi proceso cada segundo
                    After=network.target
                    [Service]
                    Type=simple
                    EnvironmentFile=/etc/environment
                    ExecStart=/bin/bash /opt/script.sh
                - path: /etc/systemd/system/my-script.timer
                  content: |
                    [Unit]
                    Description=Ejecutar mi proceso cada segundo
                    [Timer]
                    OnBootSec=1s
                    OnUnitActiveSec=1s
                    AccuracySec=10ms
                    [Install]
                    WantedBy=timers.target
              runcmd:
                - systemctl daemon-reload
                - systemctl enable --now my-script.timer
                - sed -i 's/^Listen 80/Listen 8080/' /etc/httpd/conf/httpd.conf
                - sed -i 's/<VirtualHost \*:80>/<VirtualHost *:8080>/' /etc/httpd/conf.d/*.conf || true
                - systemctl enable httpd
                - systemctl start httpd
                - yum install -y kubectl
                - kubectl version --client || true
                - #mount /dev/$(lsblk --nodeps -o name,serial| grep O9L74B| awk '{print $1}') /opt
                - sed -i '/virtio-O9L74B/d' /etc/fstab
                - echo '/dev/disk/by-id/virtio-O9L74B /opt iso9660 ro,user 0 0' >> /etc/fstab
                - mkdir -p /var/run/secrets/kubernetes.io/serviceaccount
                - #mount /dev/$(lsblk --nodeps -o name,serial| grep 7E60P0| awk '{print $1}') /var/run/secrets/kubernetes.io/serviceaccount
                - sed -i '/virtio-7E60P0/d' /etc/fstab
                - echo '/dev/disk/by-id/virtio-O9L74B /var/run/secrets/kubernetes.io/serviceaccount iso9660 ro,user 0 0' >> /etc/fstab
                - systemctl daemon-reload
                - mount -a 
{% endif %}
---

apiVersion: v1
kind: Service
metadata:
  name: apache-dynamic-service
  namespace: cross-cluster-demo
spec:
  selector:
    app: apache-dynamic
  ports:
    - port: 8080
      targetPort: 8080
  type: ClusterIP
---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: apache-dynamic-route
  namespace: cross-cluster-demo
spec:
  host: ohmygod.mylab.ocplabs.net.eu.org
  to:
    kind: Service
    name: apache-dynamic-service
    weight: 100
  port:
    targetPort: 8080
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Allow
  wildcardPolicy: None
---
kind: Route
apiVersion: route.openshift.io/v1
metadata:
  name: router-test
  namespace: cross-cluster-demo
spec:
  to:
    kind: Service
    name: apache-dynamic-service
    weight: 100
  port:
    targetPort: 8080
  tls:
    termination: edge
    insecureEdgeTerminationPolicy: Allow
  wildcardPolicy: None
